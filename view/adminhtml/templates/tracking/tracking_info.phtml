<?php /** @var $block Oxl\Delivery\Block\Adminhtml\Shipping\OxlTracking */?>
<script>
require([
    'jquery', 
    'mage/template',
    'Magento_Ui/js/modal/modal',
    'mage/translate',
    'loader', 
    'prototype'
], function(dwe, mageTemplate, modal, $t){
    //<![CDATA[
    var oxlTrackingInfo;
    oxlTrackingInfo = {
        econtUrl: "<?= $escaper->escapeHtml($block->helper()->getServiceUrl()) ?>",
        // The private key stays on the server: the trace and the waybill form go through these admin actions
        traceAction: "<?= $escaper->escapeJs($block->getUrl('oxl_delivery/waybill/trace')) ?>",
        labelUrlAction: "<?= $escaper->escapeJs($block->getUrl('oxl_delivery/waybill/labelUrl')) ?>",
        orderId: "<?= $escaper->escapeJs($block->getOrderId()) ?>",
        template: mageTemplate('#oxl_tracking_template'),
        hasTracking: false,
        waybill_url: '',
        main: function() {
            alert('main');
        },
        check: function (order_id, 
            waybill_id = 99999999, 
            currency = "<?= $escaper->escapeHtml($block->getCurrency()) ?>", s = null, i = null
        ) {
            dwe("body").trigger('processStart');
            dwe.ajax({
                url: this.traceAction,
                data: {
                    order_id: this.orderId,
                    form_key: window.FORM_KEY
                },
                type: "POST",
                dataType: 'json',
                success:function( e ){       
                    if ( e.shipmentNumber ) {
                        oxlTrackingInfo.updateButtons();
                        oxlTrackingInfo.addTrackingCode( e );
                    } else if ( e.type || ( e.message && e.shipmentNumber === undefined ) ) {
                        alert( 'Отговор от Еконт: ' + e.message );
                        if ( s && i ) {
                            s.css('visibility', 'visible');
                            dwe(i).removeClass('is-active');
                        }
                    }
                },
                // handle error (alert the error)
                error: function ( error ) {
                    alert( 'Отговор от Еконт: ' + error.responseText + "\r\nСървърен код - " + error.status + 
                    ' ( ' + error.statusText + ' ).');
                    if ( s && i ) {
                        s.css('visibility', 'visible');
                        dwe(i).removeClass('is-active');
                    }
                }
            });
            setTimeout(function(){
                dwe("body").trigger('processStop');
            }, 2000)
        },
        loadModal: function() {
            var data;
            var progressTmpl = mageTemplate('#oxl_tracking_template');
            var tmpl;

            if(this.hasTracking) {
                window.open( this.waybill_url, '_blank' )
            } else {
                data = {
                    type: "popup",
                    modalClass: "oxl-modal",
                    responsive: true,
                    responsiveClass: "modal-responsive",
                    title: $t("Deliver With Econt"),
                    buttons: []
                };            
                dwe('#oxl-modal').modal(data);
                dwe('#oxl-modal').modal('openModal');
                dwe('#oxl-modal').empty();

                // The form opens with a label session that the server gets from Econt
                dwe.ajax({
                    url: this.labelUrlAction,
                    data: {
                        order_id: this.orderId,
                        form_key: window.FORM_KEY
                    },
                    type: "POST",
                    dataType: 'json',
                    success: function( e ) {
                        if ( e.url ) {
                            tmpl = progressTmpl({
                                data: {
                                    src: e.url
                                }
                            });
                            dwe('#oxl-modal').append(tmpl);
                        } else {
                            oxlTrackingInfo.closeModal();
                            alert( 'Отговор от Еконт: ' + ( e.error || '' ) );
                        }
                    },
                    error: function ( error ) {
                        oxlTrackingInfo.closeModal();
                        alert( 'Отговор от Еконт: ' + error.responseText + "\r\nСървърен код - " + error.status + 
                        ' ( ' + error.statusText + ' ).');
                    }
                });
            }            
        },
        closeModal : function() {            
            dwe('#oxl-modal').modal('closeModal');
        },
        addTrackingCode: function(data) {
            var id;
            dwe("body").trigger('processStart');
            trackingControl.add();
            id = dwe('tbody#track_row_container tr').length;
            setTimeout(function() {
                dwe('#trackingT' + id).val('Econt');
                dwe('#trackingN' + id).val(data.shipmentNumber);
            }, 800);
            this.waybill_url = data.pdfURL;
            dwe("body").trigger('processStop');
        },
        updateButtons: function() {
            dwe('#oxl-tracking-status span').text($t('Print'));
            this.hasTracking = true;
        }
    };    

    window.oxlTrackingInfo = oxlTrackingInfo;

    window.addEventListener( 'message', function( message ) {
    // Only messages from the Econt delivery system (exact origin of the service URL)
    if(message.origin !== new URL(oxlTrackingInfo.econtUrl).origin){
        return;
    }
      
    if(message.data.event === 'cancel' ) {
        oxlTrackingInfo.closeModal();
    } else if( message.data.event === 'confirm' && Object.keys(message.data.shipmentStatus).length ) {
        oxlTrackingInfo.updateButtons();
        oxlTrackingInfo.closeModal();
        oxlTrackingInfo.addTrackingCode( message.data.shipmentStatus );
        if( message.data.printPdf && /^https:\/\//i.test(message.data.shipmentStatus.pdfURL || '') ) {
            window.open( message.data.shipmentStatus.pdfURL, '_blank' )
        }      
    }    
  })

  return oxlTrackingInfo
    //]]>

});
</script>
<script id="oxl_tracking_template" type="text/x-magento-template">    
    <iframe src="<%- data.src %>" 
        frameborder="0" 
        width="100%" 
        height="800px"
    ></iframe>
</script>
<div class="admin__page-section-item order-shipping-address">
    <?php /* Shipping Address */ ?>
    <div class="admin__page-section-item-title">
        <span class="title"><?= $escaper->escapeHtml(__('Generate Waybill')) ?></span>
    </div>
    <div class="admin__page-section-item-content shipping-description-wrapper">
        <div class="shipping-description-content">
            <div id="oxl-modal"></div>
        </div>
    </div>
    <div class="admin__control-table-wrapper" style="display: flex">
        <div class="dashboard-advanced-reports-actions">
            <button id="oxl-tracking-status" type="button" class="action action-advanced-reports" 
                data-index="analytics-service-link" 
                title="<?= $escaper->escapeHtml(__('Generate Waybill')) ?>" 
                onclick="oxlTrackingInfo.loadModal()" 
                data-ui-id="oxl-tracking-status">
                <span><?= $escaper->escapeHtml(__('Generate with Econt')) ?></span>
            </button>
        </div>
        <button
            id="oxl_check_status"
            title="<?= $escaper->escapeHtml(__('Check Tracking Status')) ?>" 
            type="button" class="action-default scalable" 
            onclick="oxlTrackingInfo.check()" 
            data-ui-id="oxl-check-tracking-status"
        >
            <span><?= $escaper->escapeHtml(__('Check status')) ?></span>
        </button>
    </div>
</div>

